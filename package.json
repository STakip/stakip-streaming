const elements = {
  startButton: document.getElementById("startButton"),
  landingScreen: document.getElementById("landingScreen"),
  streamHome: document.getElementById("streamHome"),
  searchInput: document.getElementById("searchInput"),
  trendingRow: document.getElementById("trendingRow"),
  moviesRow: document.getElementById("moviesRow"),
  seriesRow: document.getElementById("seriesRow"),
  docsRow: document.getElementById("docsRow"),
  mrRobotRow: document.getElementById("mrRobotRow")
};

function renderCards(containerId, cards) {
  const container = document.getElementById(containerId);
  const html = cards
    .map(
      (item) => `
        <article class="media-card" data-title="${item.title.toLowerCase()}">
          <div class="media-thumb" style="background-image:url('${item.image}')"></div>
          <div class="media-fade"></div>
          <div class="media-details">
            <div class="media-title">${item.title}</div>
            <div class="media-meta">
              <span>${item.type}</span>
              <span>${item.year}</span>
            </div>
          </div>
          <div class="media-badge">${item.badge}</div>
        </article>
      `
    )
    .join("");

  container.innerHTML = html;
}

function renderEpisodes() {
  const html = contentData.mrRobot
    .map(
      (item) => `
        <article class="episode-card" data-title="${item.title.toLowerCase()}">
          <div class="episode-thumb" style="background-image:url('${item.image}')"></div>
          <div class="episode-body">
            <span class="episode-number">${item.number}</span>
            <div class="episode-title">${item.title}</div>
            <div class="episode-meta">${item.meta}</div>
          </div>
        </article>
      `
    )
    .join("");

  elements.mrRobotRow.innerHTML = html;
}

function applySearch(filterText) {
  const term = filterText.trim().toLowerCase();

  document.querySelectorAll(".media-card, .episode-card").forEach((card) => {
    const title = (card.dataset.title || "").toLowerCase();
    const shouldShow = !term || title.includes(term);
    card.classList.toggle("hidden-item", !shouldShow);
  });
}

function launchHome() {
  elements.landingScreen.classList.add("hidden");
  elements.streamHome.classList.remove("hidden");
}

function init() {
  renderCards("trendingRow", contentData.trending);
  renderCards("moviesRow", contentData.movies);
  renderCards("seriesRow", contentData.series);
  renderCards("docsRow", contentData.docs);
  renderEpisodes();

  elements.startButton.addEventListener("click", launchHome);
  elements.searchInput.addEventListener("input", (event) => {
    applySearch(event.target.value);
  });
}

init();

